---
/**
 * A client's blueprint. Without a session it shows the code gate (a plain form, works without JavaScript).
 * With a session it renders the app with everything saved so far.
 */
import Base from '../../layouts/Base.astro';
import App from '../../components/App';
import Gate from '../../components/Gate.astro';
import { getClientConfig } from '../../lib/config';
import { ADMIN_COOKIE, SetupError, clientCookieName, hasAdminSession, hasClientSession } from '../../lib/auth';
import { getAnswers, getAnswersUpdatedAt, getClientRow, listOpenRounds, listUploads, toPublicUpload } from '../../lib/db';
import { BASE, getEnv } from '../../lib/http';
import type { UploadInfo } from '../../lib/summary';
import { savedPreviewIds } from '../../lib/previews';

const slug = String(Astro.params.slug ?? '');
const config = getClientConfig(slug);
const env = getEnv(Astro.locals);

let mode: 'missing' | 'gate' | 'app' | 'setup' = 'missing';
let answers = {};
let updatedAt: Record<string, string> = {};
let uploads: UploadInfo[] = [];
let openRounds: { number: number; title: string }[] = [];
let submittedAt: string | null = null;
let preview = false;
let previewIds: string[] = [];

if (config) {
  try {
    // Evan's read-only preview: ?preview=1 with a valid admin session. Nothing saves in this mode.
    preview = Astro.url.searchParams.get('preview') === '1' && (await hasAdminSession(env, Astro.cookies.get(ADMIN_COOKIE)?.value));
    mode = preview || (await hasClientSession(env, config.slug, Astro.cookies.get(clientCookieName(config.slug))?.value)) ? 'app' : 'gate';
  } catch (e) {
    if (e instanceof SetupError) mode = 'setup';
    else throw e;
  }
  if (mode === 'app') {
    const [a, t, u, row, rounds] = await Promise.all([getAnswers(env.DB, config.slug), getAnswersUpdatedAt(env.DB, config.slug), listUploads(env.DB, config.slug), getClientRow(env.DB, config.slug), listOpenRounds(env.DB, config.slug)]);
    answers = a;
    updatedAt = t;
    uploads = u.map(toPublicUpload);
    openRounds = rounds.map((r) => ({ number: r.number, title: r.title }));
    submittedAt = row?.submitted_at ?? null;
    previewIds = config.examples.length ? await savedPreviewIds(env.UPLOADS, config.slug) : [];
  }
} else {
  Astro.response.status = 404;
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const e = Astro.url.searchParams.get('e') ?? '';
const owner = config?.ownerName ?? 'Evan';
const title = config ? `${config.businessShort} blueprint` : 'Equicity Blueprint';
---
<Base title={title}>
  {mode === 'app' && config ? (
    <>
      <App client:load config={config} slug={config.slug} base={BASE} initialAnswers={answers} initialUpdatedAt={updatedAt} serverNow={new Date().toISOString()} initialUploads={uploads} submittedAt={submittedAt} openRounds={openRounds} preview={preview} previewIds={previewIds} />
      <noscript>
        <main class="eq-page"><p class="eq-lead">Your blueprint needs JavaScript turned on. Try another browser, or text {owner}.</p></main>
      </noscript>
    </>
  ) : mode === 'missing' ? (
    <main class="eq-page bp-gate">
      <img class="eq-top__logo" src={`${BASE}equicity-logo.png`} alt="Equicity" width="110" height="22" />
      <h1 class="eq-h1">We couldn't find that blueprint.</h1>
      <p class="eq-lead">Check the link in the email from Evan. If it still doesn't open, text him and he'll send a fresh one.</p>
    </main>
  ) : (
    <Gate config={config!} mode={mode === 'setup' ? 'setup' : 'gate'} error={e} />
  )}
</Base>
