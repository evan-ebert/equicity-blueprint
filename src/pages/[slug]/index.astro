---
/**
 * A client's blueprint. Without a session it shows the code gate (a plain form, works without JavaScript).
 * With a session it renders the app with everything saved so far.
 */
import Base from '../../layouts/Base.astro';
import App from '../../components/App';
import { Icon } from '../../components/icons';
import { getClientConfig } from '../../lib/config';
import { SetupError, clientCookieName, hasClientSession } from '../../lib/auth';
import { getAnswers, getClientRow, listUploads, toPublicUpload } from '../../lib/db';
import { BASE, getEnv, withBase } from '../../lib/http';
import type { UploadInfo } from '../../lib/summary';

const slug = String(Astro.params.slug ?? '');
const config = getClientConfig(slug);
const env = getEnv(Astro.locals);

let mode: 'missing' | 'gate' | 'app' | 'setup' = 'missing';
let answers = {};
let uploads: UploadInfo[] = [];
let submittedAt: string | null = null;

if (config) {
  try {
    mode = (await hasClientSession(env, config.slug, Astro.cookies.get(clientCookieName(config.slug))?.value)) ? 'app' : 'gate';
  } catch (e) {
    if (e instanceof SetupError) mode = 'setup';
    else throw e;
  }
  if (mode === 'app') {
    const [a, u, row] = await Promise.all([getAnswers(env.DB, config.slug), listUploads(env.DB, config.slug), getClientRow(env.DB, config.slug)]);
    answers = a;
    uploads = u.map(toPublicUpload);
    submittedAt = row?.submitted_at ?? null;
  }
} else {
  Astro.response.status = 404;
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const errors: Record<string, string> = {
  code: "That code didn't match. Check the email from {owner} and try again. Capital letters and spaces don't matter.",
  wait: 'Too many tries for now. Take a short break and try again in about 15 minutes.',
  notready: "Your blueprint isn't open yet. {owner} will send your code when it's ready.",
  setup: "Something isn't set up on our end yet. Text {owner} and we'll sort it out.",
};
const e = Astro.url.searchParams.get('e') ?? '';
const owner = config?.ownerName ?? 'Evan';
const errorText = mode === 'setup' ? errors.setup.replaceAll('{owner}', owner) : errors[e]?.replaceAll('{owner}', owner);
const title = config ? `${config.businessShort} blueprint` : 'Equicity Blueprint';
---
<Base title={title}>
  {mode === 'app' && config ? (
    <>
      <App client:load config={config} slug={config.slug} base={BASE} initialAnswers={answers} initialUploads={uploads} submittedAt={submittedAt} />
      <noscript>
        <main class="eq-page"><p class="eq-lead">Your blueprint needs JavaScript turned on. Try another browser, or text {owner}.</p></main>
      </noscript>
    </>
  ) : mode === 'missing' ? (
    <main class="eq-page bp-gate">
      <img class="eq-top__logo" src={`${BASE}equicity-logo.png`} alt="Equicity" width="110" height="22" />
      <h1 class="eq-h1">We couldn't find that blueprint.</h1>
      <p class="eq-lead">Check the link in the email from Evan. If it still doesn't open, text him and he'll send a fresh one.</p>
    </main>
  ) : (
    <main class="eq-page bp-gate">
      <img class="eq-top__logo" src={`${BASE}equicity-logo.png`} alt="Equicity" width="110" height="22" />
      <header class="eq-stack" style="gap:14px">
        <span class="eq-eyebrow" style="justify-self:start">Your blueprint</span>
        <h1 class="eq-h1">Hi {config!.firstName}, welcome in.</h1>
        <p class="eq-lead">Enter the code from {owner}'s email to open your {config!.businessShort} blueprint.</p>
      </header>
      {errorText && (
        <p class="bp-alert" role="alert"><Icon name="alert" size={18} /><span>{errorText}</span></p>
      )}
      {mode === 'gate' && (
        <form method="post" action={withBase(`api/${config!.slug}/login`)}>
          <label class="eq-field">
            <span class="eq-field__label">Your code</span>
            <input class="eq-input eq-input--code" name="code" required minlength="4" maxlength="12" autocomplete="one-time-code" autocapitalize="characters" autocorrect="off" spellcheck="false" placeholder="ABC 234" />
          </label>
          <button type="submit" class="eq-btn eq-btn--primary eq-btn--block">Open my blueprint</button>
        </form>
      )}
      <p class="bp-note"><Icon name="lock" /><span>Private to you and {owner}. Once you're in, this device remembers you, and you can open the same link on any other device with the same code.</span></p>
    </main>
  )}
</Base>
